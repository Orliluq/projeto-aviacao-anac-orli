{
  "datasets": [
    {
      "name": "25a11c59",
      "displayName": "vra_quarentena",
      "config": {
        "version": "1.1",
        "source": "voebem.silver.vra_quarentena",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "obt_voos",
      "displayName": "Voos - Atrasos e Pontualidade",
      "config": {
        "source": "voebem.gold.obt_voos",
        "measures": [
          {
            "name": "total_voos",
            "expr": "COUNT(*)",
            "displayName": "Total de Voos"
          },
          {
            "name": "voos_atrasados_partida",
            "expr": "SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END)",
            "displayName": "Voos Atrasados na Partida"
          },
          {
            "name": "voos_atrasados_chegada",
            "expr": "SUM(CASE WHEN chegada_pontual = false THEN 1 ELSE 0 END)",
            "displayName": "Voos Atrasados na Chegada"
          },
          {
            "name": "voos_cancelados",
            "expr": "SUM(CASE WHEN voo_cancelado THEN 1 ELSE 0 END)",
            "displayName": "Voos Cancelados"
          },
          {
            "name": "voos_realizados",
            "expr": "SUM(CASE WHEN voo_realizado THEN 1 ELSE 0 END)",
            "displayName": "Voos Realizados"
          },
          {
            "name": "voos_pontuais_chegada",
            "expr": "SUM(CASE WHEN chegada_pontual = true THEN 1 ELSE 0 END)",
            "displayName": "Voos Pontuais na Chegada"
          },
          {
            "name": "atraso_medio_partida",
            "expr": "AVG(atraso_partida_min)",
            "displayName": "Atraso Médio na Partida (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atraso_medio_chegada",
            "expr": "AVG(atraso_chegada_min)",
            "displayName": "Atraso Médio na Chegada (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "recuperacao_media",
            "expr": "AVG(minutos_recuperados)",
            "displayName": "Recuperação Média (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_atraso_partida",
            "expr": "SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END), 0)",
            "displayName": "Taxa de Atraso na Partida",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_atraso_chegada",
            "expr": "SUM(CASE WHEN chegada_pontual = false THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN chegada_pontual IS NOT NULL THEN 1 ELSE 0 END), 0)",
            "displayName": "Taxa de Atraso na Chegada",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_chegada_pontual",
            "expr": "SUM(CASE WHEN chegada_pontual = true THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN chegada_pontual IS NOT NULL THEN 1 ELSE 0 END), 0)",
            "displayName": "Taxa de Chegada Pontual",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Análise de atrasos de voos no Brasil (ANAC/VRA) - período ago/2025 a jul/2026",
        "dimensions": [
          {
            "name": "nome_companhia",
            "expr": "nome_companhia",
            "displayName": "Companhia",
            "comment": "Razão social da companhia aérea"
          },
          {
            "name": "icao_origem",
            "expr": "icao_origem",
            "displayName": "ICAO Origem"
          },
          {
            "name": "nome_aeroporto_origem",
            "expr": "nome_aeroporto_origem",
            "displayName": "Aeroporto de Origem"
          },
          {
            "name": "municipio_origem",
            "expr": "municipio_origem",
            "displayName": "Município de Origem"
          },
          {
            "name": "uf_origem",
            "expr": "uf_origem",
            "displayName": "UF de Origem"
          },
          {
            "name": "icao_destino",
            "expr": "icao_destino",
            "displayName": "ICAO Destino"
          },
          {
            "name": "nome_aeroporto_destino",
            "expr": "nome_aeroporto_destino",
            "displayName": "Aeroporto de Destino"
          },
          {
            "name": "rota_icao",
            "expr": "rota_icao",
            "displayName": "Rota (ICAO)"
          },
          {
            "name": "rota_municipios",
            "expr": "rota_municipios",
            "displayName": "Rota"
          },
          {
            "name": "hora_partida_prevista",
            "expr": "hora_partida_prevista",
            "displayName": "Hora da Partida",
            "comment": "Hora cheia programada da partida, de 0 a 23"
          },
          {
            "name": "dia_semana",
            "expr": "dia_semana",
            "displayName": "Dia da Semana"
          },
          {
            "name": "mes_referencia",
            "expr": "mes_referencia",
            "displayName": "Mês de Referência",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "escopo_voo",
            "expr": "escopo_voo",
            "displayName": "Escopo do Voo"
          },
          {
            "name": "descricao_di",
            "expr": "descricao_di",
            "displayName": "Tipo de Etapa"
          },
          {
            "name": "descricao_tipo_linha",
            "expr": "descricao_tipo_linha",
            "displayName": "Tipo de Linha"
          },
          {
            "name": "situacao_voo",
            "expr": "situacao_voo",
            "displayName": "Situação do Voo"
          },
          {
            "name": "faixa_atraso_partida",
            "expr": "CASE\n  WHEN atraso_partida_min IS NULL THEN 'Sem info/cancelado'\n  WHEN atraso_partida_min <= 0 THEN 'Pontual/adiantado'\n  WHEN atraso_partida_min BETWEEN 1 AND 15 THEN 'Atraso leve (1-15 min)'\n  WHEN atraso_partida_min BETWEEN 16 AND 60 THEN 'Atraso moderado (16-60 min)'\n  WHEN atraso_partida_min BETWEEN 61 AND 120 THEN 'Atraso grave (61-120 min)'\n  ELSE 'Atraso severo (>120 min)'\nEND",
            "displayName": "Faixa de Atraso na Partida"
          }
        ]
      }
    }
  ],
